# Homebrew formula for unroll, generated by .github/workflows/release.yml from
# packaging/homebrew/unroll.rb.template. Edit the template, not the copy in the tap.
class Unroll < Formula
  desc "Copy only new iPhone photos to a folder, optionally referenced in Apple Photos"
  homepage "https://github.com/carl-castell/unroll"
  url "https://github.com/carl-castell/unroll/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"
  head "https://github.com/carl-castell/unroll.git", branch: "main"

  # Builds with the Swift that comes with Xcode or the Command Line Tools.
  depends_on macos: :sonoma

  def install
    system "swift", "build", "--disable-sandbox", "--configuration", "release", "--product", "unroll"
    bin.install ".build/release/unroll"
    man1.install "docs/unroll.1"
    generate_completions_from_executable(bin/"unroll", "--generate-completion-script")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/unroll --version")
    assert_match "Copy only the new photos", shell_output("#{bin}/unroll --help")
    assert_match "EXIT CODES", shell_output("#{bin}/unroll help exit-codes")
    # Without a terminal, a run of an unknown task fails cleanly with exit code 4.
    ENV["XDG_CONFIG_HOME"] = testpath
    assert_match "No sync tasks yet", shell_output("#{bin}/unroll run nothing 2>&1", 4)
  end
end
